{
  "expo": {
    "name": "thesis-walking-app",
    "slug": "thesis-walking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thesiswalkingapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.jgoose.thesiswalkingapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.33.0"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow the app to show current location on map."
        }
      ],
      [
        "@rnmapbox/navigation",
        {
          "RNMapboxNavigationVersion": "3.33.0"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow the app to access your device motion to count your steps."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "18414e60-1883-40a4-8066-2af589a695be"
      }
    },
    "owner": "jgoose"
  }
}
